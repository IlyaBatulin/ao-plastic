# Публичный URL сайта (ОБЯЗАТЕЛЬНО в продакшене — для sitemap, robots, Open Graph, canonical):
# NEXT_PUBLIC_SITE_URL=https://www.oaplastic.ru

# Подтверждение сайта в поисковых системах (meta verification):
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=код_из_Google_Search_Console
# NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=код_из_Яндекс_Вебмастер

# Опционально: пароль на весь сайт (кроме /login, /robots.txt, /sitemap.xml, статики).
# ВАЖНО: пока пароль включён, обычные пользователи не видят сайт.
# Поисковые роботы (Googlebot, Yandexbot) пропускаются автоматически для индексации.
# SITE_PASSWORD=

# Секретный путь админки (стандартный /admin будет 404)
# ADMIN_PATH=panel-ваш-код

# --- Пароли админки по ролям ---
# Руководитель — полный доступ ко всем разделам:
# ADMIN_PASSWORD=пароль_руководителя
# Отдел продаж — заказы, заявки поставщиков, сообщения, менеджеры:
# ADMIN_SALES_PASSWORD=пароль_продаж
# Маркетолог — товары, категории, новости, вакансии:
# ADMIN_MARKETING_PASSWORD=пароль_маркетинга
# Опционально: отдельный секрет подписи сессий (иначе используется ADMIN_PASSWORD):
# ADMIN_SESSION_SECRET=случайная_длинная_строка

# --- Уведомления о заказах на почту (SMTP) ---
# Куда присылать письма (можно несколько через запятую):
# ORDER_NOTIFY_EMAIL=ваш@mail.ru
#
# SMTP (примеры: Mail.ru — smtp.mail.ru:465, Яндекс — smtp.yandex.ru:465):
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ваш@mail.ru
# SMTP_PASS=пароль_приложения
# SMTP_FROM="АО Пластик" <ваш@mail.ru>

# --- Временный демонстрационный вход в кабинет покупателя ---
# Задайте только в окружении хостинга. Не коммитьте реальные значения.
# CUSTOMER_PREVIEW_LOGIN=adminplast
# CUSTOMER_PREVIEW_PASSWORD=смените_пароль
# CUSTOMER_PREVIEW_SECRET=случайная_строка_не_короче_32_символов
