# Публичный URL сайта (для sitemap, robots, Open Graph). В продакшене обязательно:
# NEXT_PUBLIC_SITE_URL=https://www.example.ru

# Подтверждение сайта в Google Search Console (meta verification)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Опционально: пароль на весь сайт (кроме /login, /robots.txt, /sitemap.xml, статики)
# SITE_PASSWORD=

# Секретный путь админки
# ADMIN_PATH=
