# Публичный URL сайта (ОБЯЗАТЕЛЬНО в продакшене — для sitemap, robots, Open Graph, canonical):
# NEXT_PUBLIC_SITE_URL=https://www.oaplastic.ru

# Подтверждение сайта в поисковых системах (meta verification):
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=код_из_Google_Search_Console
# NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=код_из_Яндекс_Вебмастер

# Опционально: пароль на весь сайт (кроме /login, /robots.txt, /sitemap.xml, статики).
# ВАЖНО: пока пароль включён, обычные пользователи не видят сайт.
# Поисковые роботы (Googlebot, Yandexbot) пропускаются автоматически для индексации.
# SITE_PASSWORD=

# Секретный путь админки (стандартный /admin будет 404)
# ADMIN_PATH=panel-ваш-код
